# Hive Automation Bot - Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your real .env file or credentials to source control!

# ===== REQUIRED =====

# Hive Platform Credentials
HIVE_LOGIN_URL=https://hive.smartinterviews.in/login
HIVE_CONTEST_URL=https://hive.smartinterviews.in/contests/smart-interviews-basic
HIVE_USERNAME=your_username_here
HIVE_PASSWORD=your_password_here

# ===== AI PROVIDER (at least one valid provider required) =====

# OpenAI API (Optional fallback)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API (Optional fallback)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API (Recommended primary provider - fast inference)
GROQ_API_KEY=your_groq_api_key_here

# ===== SOLVER CONFIGURATION =====
DEFAULT_LANGUAGE=C++
MAX_ATTEMPTS=5

# Model IDs (Configuration-driven; no model IDs hardcoded in code)
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini

# ===== OPTIONAL BROWSER & LOGGING SETTINGS =====
BROWSER_HEADLESS=false
BROWSER_PROFILE_PATH=~/.hive_bot_profile
LOG_LEVEL=INFO
DRY_RUN=false
